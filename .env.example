# Only ollama is implemented. Anthropic is reserved for future work.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=120

# Reserved; selecting anthropic is not currently supported.
ANTHROPIC_API_KEY=

# Per-message hard limits, including retries.
MAX_LLM_CALLS=10
MAX_TOOL_CALLS=5
CLASSIFY_MAX_OUTPUT_TOKENS=256
ANSWER_MAX_OUTPUT_TOKENS=768
VERIFY_MAX_OUTPUT_TOKENS=1536
# Advisory threshold for reported input + output tokens; not a hard token cap.
MAX_TOTAL_TOKENS=20000
# Parsed placeholder; the implemented refund approval rule is hard-coded at USD 50.
REFUND_AUTO_APPROVE_LIMIT=50
